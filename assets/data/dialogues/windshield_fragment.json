{
  "start_node_id": 0,
  "nodes": [
    {
      "id": 0,
      "speaker": "Evan",
      "text": "Glass.",
      "next_id": 1,
      "options": []
    },
    {
      "id": 1,
      "speaker": "Evan",
      "text": "From the windshield.",
      "next_id": 2,
      "options": []
    },
    {
      "id": 2,
      "speaker": "Evan",
      "text": "I remember the rain.",
      "next_id": 3,
      "options": []
    },
    {
      "id": 3,
      "speaker": "",
      "text": "Remember this memory?",
      "next_id": -1,
      "options": [
        { "text": "Remember", "target_id": 100 },
        { "text": "Forget", "target_id": -1 }
      ]
    },
    {
      "id": 100,
      "speaker": "Grace",
      "text": "Slow down.",
      "next_id": 101,
      "options": []
    },
    {
      "id": 101,
      "speaker": "Evan",
      "text": "We're already late.",
      "next_id": 102,
      "options": []
    },
    {
      "id": 102,
      "speaker": "Grace",
      "text": "Pull over.",
      "next_id": 103,
      "options": []
    },
    {
      "id": 103,
      "speaker": "Evan",
      "text": "You wanted me to leave.",
      "next_id": 104,
      "options": []
    },
    {
      "id": 104,
      "speaker": "Grace",
      "text": "I wanted you to go.",
      "next_id": 105,
      "options": []
    },
    {
      "id": 105,
      "speaker": "Evan",
      "text": "Without you.",
      "next_id": 106,
      "options": []
    },
    {
      "id": 106,
      "speaker": "Grace",
      "text": "I wanted you to have a future.",
      "next_id": 107,
      "options": []
    },
    {
      "id": 107,
      "speaker": "Evan",
      "text": "I don't want it.",
      "next_id": 108,
      "options": []
    },
    {
      "id": 108,
      "speaker": "Grace",
      "text": "You don't mean that.",
      "next_id": 109,
      "options": []
    },
    {
      "id": 109,
      "speaker": "Evan",
      "text": "You don't get to decide that for me.",
      "next_id": 110,
      "options": []
    },
    {
      "id": 110,
      "speaker": "Grace",
      "text": "Evan, please.",
      "next_id": 111,
      "options": []
    },
    {
      "id": 111,
      "speaker": "Evan",
      "text": "You already decided.",
      "next_id": 112,
      "options": []
    },
    {
      "id": 112,
      "speaker": "Grace",
      "text": "I love you.",
      "next_id": 113,
      "options": []
    },
    {
      "id": 113,
      "speaker": "Evan",
      "text": "Then come with me.",
      "next_id": 114,
      "options": []
    },
    {
      "id": 114,
      "speaker": "Grace",
      "text": "I can't.",
      "next_id": 115,
      "options": []
    },
    {
      "id": 115,
      "speaker": "Grace",
      "text": "Please slow down.",
      "next_id": 116,
      "options": []
    },
    {
      "id": 116,
      "speaker": "",
      "text": "*Horn. Brakes. CRASH.*",
      "next_id": 200,
      "options": []
    },
    {
      "id": 200,
      "speaker": "THE VOICE",
      "text": "Now you remember.",
      "next_id": 201,
      "options": []
    },
    {
      "id": 201,
      "speaker": "Evan",
      "text": "Yes.",
      "next_id": 202,
      "options": []
    },
    {
      "id": 202,
      "speaker": "THE VOICE",
      "text": "She gave you everything.",
      "next_id": 203,
      "options": []
    },
    {
      "id": 203,
      "speaker": "Evan",
      "text": "I know.",
      "next_id": 204,
      "options": []
    },
    {
      "id": 204,
      "speaker": "THE VOICE",
      "text": "And what did you give her?",
      "next_id": 205,
      "options": []
    },
    {
      "id": 205,
      "speaker": "Evan",
      "text": "...",
      "next_id": 206,
      "options": []
    },
    {
      "id": 206,
      "speaker": "THE VOICE",
      "text": "You survived.",
      "next_id": 207,
      "options": []
    },
    {
      "id": 207,
      "speaker": "Evan",
      "text": "I didn't ask to.",
      "next_id": 208,
      "options": []
    },
    {
      "id": 208,
      "speaker": "THE VOICE",
      "text": "Neither did she.",
      "next_id": 209,
      "options": []
    },
    {
      "id": 209,
      "speaker": "THE VOICE",
      "text": "You can stay.",
      "next_id": 210,
      "options": []
    },
    {
      "id": 210,
      "speaker": "Evan",
      "text": "And then?",
      "next_id": 211,
      "options": []
    },
    {
      "id": 211,
      "speaker": "THE VOICE",
      "text": "Then nothing changes.",
      "next_id": 212,
      "options": []
    },
    {
      "id": 212,
      "speaker": "Evan",
      "text": "That's the point.",
      "next_id": 213,
      "options": []
    },
    {
      "id": 213,
      "speaker": "THE VOICE",
      "text": "Isn't it?",
      "next_id": -1,
      "options": []
    }
  ]
}
